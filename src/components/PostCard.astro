---
import FormattedDate from './FormattedDate.astro';
import { CATEGORY_LABELS } from '../content/config';
import type { CategorySlug } from '../content/config';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  category: CategorySlug;
  tags: string[];
}

const { title, description, pubDate, slug, category, tags } = Astro.props;
const categoryLabel = CATEGORY_LABELS[category];
---

<article class="border border-gray-200 rounded-lg p-6 hover:border-orange-300 hover:shadow-md transition-all duration-200 bg-white">
  <div class="flex items-center gap-2 mb-3">
    <span class="text-xs font-medium text-orange-600 bg-orange-50 px-2 py-1 rounded">
      {categoryLabel}
    </span>
    <span class="text-xs text-gray-400">
      <FormattedDate date={pubDate} />
    </span>
  </div>
  <h2 class="text-lg font-bold text-gray-900 mb-2 leading-tight">
    <a href={`/posts/${slug.replace(/\.mdx?$/, '')}`} class="hover:text-orange-600 no-underline text-gray-900">
      {title}
    </a>
  </h2>
  <p class="text-sm text-gray-600 leading-relaxed line-clamp-2 mb-3">
    {description}
  </p>
  <div class="flex flex-wrap gap-1">
    {tags.slice(0, 3).map((tag) => (
      <span class="text-xs text-gray-500 bg-gray-100 px-2 py-0.5 rounded">
        #{tag}
      </span>
    ))}
  </div>
</article>
