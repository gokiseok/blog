---
import FormattedDate from './FormattedDate.astro';
import { CATEGORY_CONFIG } from '../utils/categories';
import type { CategorySlug } from '../utils/categories';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  category: CategorySlug;
  tags: string[];
  readingTime?: string;
}

const { title, description, pubDate, slug, category, tags, readingTime } = Astro.props;
const config = CATEGORY_CONFIG[category];
---

<article class="post-item">
  <!-- 카테고리·날짜 -->
  <div class="flex items-center gap-2 mb-3">
    <a
      href={`/categories/${category}`}
      class="cat-badge no-underline"
      style={`color: ${config.color}`}
    >
      {config.label}
    </a>
    <span class="text-ink-muted text-[13px]">·</span>
    <span class="font-sans text-[13px] text-ink-muted">
      <FormattedDate date={pubDate} />
    </span>
  </div>

  <!-- 제목 -->
  <h2 class="font-serif font-bold text-[22px] md:text-[24px] text-black leading-snug tracking-[-0.02em] mb-2">
    <a
      href={`/posts/${slug}`}
      class="no-underline text-black hover:text-accent"
      style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;"
    >
      {title}
    </a>
  </h2>

  <!-- 설명 -->
  <p
    class="font-sans text-[15px] text-ink-sub leading-relaxed mb-3"
    style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;"
  >
    {description}
  </p>

  <!-- 읽기 시간 -->
  {readingTime && (
    <p class="font-sans text-[13px] text-ink-muted">{readingTime}</p>
  )}
</article>
