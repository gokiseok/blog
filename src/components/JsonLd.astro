---
import type { CategorySlug } from '../utils/categories';

interface Props {
  pageType: 'home' | 'about' | 'post' | 'category' | 'list';
  title?: string;
  description?: string;
  url?: string;
  pubDate?: Date;
  updatedDate?: Date;
  category?: CategorySlug;
  schemaType?: 'Article' | 'Restaurant' | 'HowTo' | 'FAQPage';
}

const {
  pageType,
  title,
  description,
  url = Astro.url.href,
  pubDate,
  updatedDate,
  category,
  schemaType = 'Article',
} = Astro.props;

const siteUrl = 'https://blog.gokiseok.com';

const restaurantSchema = {
  '@context': 'https://schema.org',
  '@id': 'https://bbq.gokiseok.com/#restaurant',
  '@type': ['Restaurant', 'LocalBusiness'],
  name: '고기석 건대본점',
  description: '서울 건대입구역 도보 1분 거리의 통갈매기살 전문점. 시그니처 통갈매기살 100g 7,000원, 10·14·32인 단체룸 운영.',
  url: 'https://bbq.gokiseok.com',
  telephone: '+82-507-1433-0614',
  image: 'https://blog.gokiseok.com/images/gokiseok-tonggalmaegisal-100g-7000won.jpg',
  servesCuisine: 'Korean BBQ',
  priceRange: '₩₩',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '동일로22길 117-13',
    addressLocality: '광진구',
    addressRegion: '서울',
    addressCountry: 'KR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 37.541415,
    longitude: 127.070753,
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '17:30',
    closes: '21:30',
  }],
  hasMenu: 'https://bbq.gokiseok.com',
  acceptsReservations: 'https://booking.naver.com/booking/6/bizes/1095878',
  publicAccess: true,
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '고기석 블로그',
  url: siteUrl,
  description: '자영업 × AI × 데이터 — 고기석 블로그',
};

function buildArticleSchema() {
  const base: Record<string, unknown> = {
    '@context': 'https://schema.org',
    '@type': schemaType === 'HowTo' ? 'HowTo' : schemaType === 'FAQPage' ? 'FAQPage' : 'Article',
    headline: title,
    description,
    url,
    author: {
      '@type': 'Organization',
      name: '고기석 블로그',
      url: siteUrl,
    },
    publisher: {
      '@type': 'Organization',
      name: '고기석 블로그',
      url: siteUrl,
    },
  };
  if (pubDate) base.datePublished = pubDate.toISOString();
  if (updatedDate) base.dateModified = updatedDate.toISOString();
  return base;
}

let schemas: unknown[] = [];

if (pageType === 'home') {
  schemas = [websiteSchema, restaurantSchema];
} else if (pageType === 'about') {
  schemas = [websiteSchema];
} else if (pageType === 'post') {
  schemas = [buildArticleSchema()];
  if (category === 'gokiseok-bbq') {
    schemas.push(restaurantSchema);
  }
} else if (pageType === 'list' || pageType === 'category') {
  schemas = [websiteSchema];
}
---

{schemas.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema, null, 0)} />
))}
