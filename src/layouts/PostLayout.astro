---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import JsonLd from '../components/JsonLd.astro';
import PostCard from '../components/PostCard.astro';
import { CATEGORY_CONFIG } from '../utils/categories';
import type { CategorySlug } from '../utils/categories';
import { getReadingTime } from '../utils/reading-time';
import { getCollection } from 'astro:content';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  category: CategorySlug;
  tags: string[];
  schemaType: 'Article' | 'Restaurant' | 'HowTo' | 'FAQPage';
  body: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  category,
  tags,
  schemaType,
  body,
} = Astro.props;

const catConfig = CATEGORY_CONFIG[category];
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const readingTime = getReadingTime(body);

// 관련 글 (같은 카테고리, 최신 2개)
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter((p) => p.data.category === category && p.data.title !== title)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={heroImage}
      type="article"
      pubDate={pubDate}
      canonicalURL={canonicalURL}
    />
    <JsonLd
      pageType="post"
      title={title}
      description={description}
      url={canonicalURL.href}
      pubDate={pubDate}
      updatedDate={updatedDate}
      category={category}
      schemaType={schemaType}
    />
  </head>
  <body>
    <Header />
    <main>
      <article>
        <!-- 글 헤더 -->
        <div class="max-w-reading mx-auto px-5 md:px-0 pt-20 md:pt-28">

          <!-- 카테고리 뱃지 -->
          <a
            href={`/categories/${category}`}
            class="cat-badge no-underline block mb-6"
            style={`color: ${catConfig.color}`}
          >
            {catConfig.label}
          </a>

          <!-- 제목 (명조) -->
          <h1 class="font-serif font-bold text-[28px] md:text-[40px] text-black leading-[1.4] tracking-[-0.02em] mb-5">
            {title}
          </h1>

          <!-- description -->
          <p class="font-sans text-[18px] text-ink-sub leading-[1.7] mb-10">
            {description}
          </p>

          <!-- 저자·날짜·읽기시간 -->
          <div class="flex items-center gap-3 mb-10">
            <!-- 이니셜 원 -->
            <div
              class="flex-none w-8 h-8 rounded-full flex items-center justify-center font-serif font-bold text-[14px] text-white"
              style="background: #C2410C;"
              aria-hidden="true"
            >
              고
            </div>
            <div class="flex items-center gap-2 font-sans text-[14px] text-ink-sub flex-wrap">
              <span class="font-medium text-ink">고기석</span>
              <span class="text-ink-muted">·</span>
              <FormattedDate date={pubDate} />
              {updatedDate && (
                <>
                  <span class="text-ink-muted">·</span>
                  <span>수정 <FormattedDate date={updatedDate} /></span>
                </>
              )}
              <span class="text-ink-muted">·</span>
              <span>{readingTime}</span>
            </div>
          </div>

          <!-- 상단 구분선 -->
          <hr class="divider mb-10" />
        </div>

        <!-- 히어로 이미지 (있을 때만) -->
        {heroImage && (
          <div class="max-w-reading mx-auto px-5 md:px-0 mb-10">
            <img
              src={heroImage}
              alt={title}
              class="w-full"
              style="border-radius:0;"
            />
          </div>
        )}

        <!-- 본문 -->
        <div class="max-w-reading mx-auto px-5 md:px-0 pb-20">
          <div class="prose">
            <slot />
          </div>
        </div>

        <!-- 글 하단 -->
        <div class="max-w-reading mx-auto px-5 md:px-0">
          <hr class="divider mb-10" />

          <!-- 저자 섹션 -->
          <div class="flex items-start gap-4 mb-10">
            <div
              class="flex-none w-12 h-12 rounded-full flex items-center justify-center font-serif font-bold text-[18px] text-white"
              style="background: #C2410C;"
              aria-hidden="true"
            >
              고
            </div>
            <div>
              <p class="font-serif font-bold text-[18px] text-black mb-1">고기석</p>
              <p class="font-sans text-[14px] text-ink-sub leading-relaxed mb-2">
                건대 통갈매기살 전문점 '고기석 건대본점' 대표
              </p>
              <a
                href="https://bbq.gokiseok.com"
                target="_blank"
                rel="noopener noreferrer"
                class="font-sans font-medium text-[14px] text-accent no-underline hover:underline"
              >
                매장 방문하기 →
              </a>
            </div>
          </div>

          <!-- 관련 글 -->
          {relatedPosts.length > 0 && (
            <div class="mt-4">
              <hr class="divider mb-10" />
              <h3 class="font-serif font-bold text-[18px] text-black mb-0">
                이 글과 함께 읽어보세요
              </h3>
              {relatedPosts.map((post) => (
                <PostCard
                  title={post.data.title}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                  slug={post.id.replace(/\.mdx?$/, '')}
                  category={post.data.category}
                  tags={post.data.tags}
                  readingTime={getReadingTime(post.body)}
                />
              ))}
            </div>
          )}
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
