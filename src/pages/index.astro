---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORY_CONFIG } from '../utils/categories';
import { getReadingTime } from '../utils/reading-time';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const categories = Object.entries(CATEGORY_CONFIG);
---

<BaseLayout
  title="고기석 블로그 - 자영업 × AI × 데이터"
  description="건대입구역 통갈매기살 전문점 고기석 건대본점 운영기. 자영업 운영 실전, AI 자동화 개발기, 데이터 기반 분석을 씁니다."
  pageType="home"
>
  <!-- 히어로 -->
  <section class="max-w-reading mx-auto px-5 md:px-0 pt-24 md:pt-36 pb-16 md:pb-20">
    <p
      class="font-sans font-medium text-[13px] text-accent uppercase tracking-[0.1em] mb-6"
    >
      AI 사장 고기석
    </p>
    <h1
      class="font-serif font-bold text-[34px] md:text-[52px] text-black leading-[1.35] tracking-[-0.02em] mb-6 whitespace-pre-line"
    >
      {"자영업과 AI 사이에서,\n기록합니다"}
    </h1>
    <p class="font-sans text-[16px] text-ink-sub leading-[1.7] max-w-[560px]">
      건대 통갈매기살 전문점 고기석 건대본점을 운영하며,<br class="hidden md:block" />
      자영업자에게 도움이 되는 AI 도구를 만듭니다.
    </p>
  </section>

  <div class="max-w-reading mx-auto px-5 md:px-0">
    <hr class="divider" />
  </div>

  <!-- 최근 글 -->
  <section class="max-w-reading mx-auto px-5 md:px-0 pt-16 md:pt-20">
    <h2 class="font-serif font-bold text-[22px] text-black tracking-[-0.02em] mb-10">
      최근 글
    </h2>

    {recentPosts.length > 0 ? (
      <div>
        {recentPosts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.id.replace(/\.mdx?$/, '')}
            category={post.data.category}
            tags={post.data.tags}
            readingTime={getReadingTime(post.body)}
          />
        ))}
      </div>
    ) : (
      <p class="font-sans text-[15px] text-ink-sub py-12">곧 첫 글이 올라옵니다.</p>
    )}

    <div class="pt-8">
      <a href="/posts" class="font-sans font-medium text-[15px] text-accent no-underline hover:underline">
        전체 글 보기 →
      </a>
    </div>
  </section>

  <!-- 카테고리 -->
  <section class="max-w-reading mx-auto px-5 md:px-0 pt-20 md:pt-24 pb-4">
    <hr class="divider mb-16" />
    <h2 class="font-serif font-bold text-[22px] text-black tracking-[-0.02em] mb-8">
      카테고리
    </h2>
    <div class="flex flex-col">
      {categories.map(([slug, config]) => (
        <a
          href={`/categories/${slug}`}
          class="group py-5 border-b border-[#EAEAEA] last:border-0 no-underline"
        >
          <p
            class="font-serif font-bold text-[20px] leading-snug tracking-[-0.02em] mb-1 group-hover:underline decoration-1"
            style={`color: ${config.color}`}
          >
            {config.label}
          </p>
          <p class="font-sans text-[15px] text-ink-sub leading-relaxed">
            {config.description}
          </p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
