---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORY_CONFIG } from '../../utils/categories';
import type { CategorySlug } from '../../utils/categories';
import { getReadingTime } from '../../utils/reading-time';

export async function getStaticPaths() {
  const slugs = Object.keys(CATEGORY_CONFIG) as CategorySlug[];
  return slugs.map((category) => ({ params: { category } }));
}

const { category } = Astro.params as { category: CategorySlug };
const config = CATEGORY_CONFIG[category];

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts
  .filter((post) => post.data.category === category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title={`${config.label} - 고기석 블로그`}
  description={`${config.label}: ${config.description}. 고기석 블로그.`}
  pageType="category"
>
  <div class="max-w-reading mx-auto px-5 md:px-0 pt-24 md:pt-32 pb-4">

    <!-- 카테고리 헤더 -->
    <h1
      class="font-serif font-bold text-[40px] md:text-[52px] leading-tight tracking-[-0.02em] mb-4"
      style={`color: ${config.color}`}
    >
      {config.label}
    </h1>
    <p class="font-sans text-[17px] text-ink-sub leading-relaxed mb-3">
      {config.description}
    </p>
    <p class="font-sans text-[14px] text-ink-muted mb-10">
      총 {posts.length}개의 글
    </p>

    <hr class="divider mb-0" />

    <!-- 글 목록 -->
    {posts.length > 0 ? (
      <div>
        {posts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.id.replace(/\.mdx?$/, '')}
            category={post.data.category}
            tags={post.data.tags}
            readingTime={getReadingTime(post.body)}
          />
        ))}
      </div>
    ) : (
      <p class="font-sans text-[15px] text-ink-sub py-12">이 카테고리에 아직 글이 없습니다.</p>
    )}
  </div>
</BaseLayout>
